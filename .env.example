# Hugging Face token: model downloads and uploads.
HF_TOKEN=

# The teacher: an OpenAI-compatible endpoint serving Qwen/Qwen3.5-35B-A3B (AWQ 4-bit in the project), which writes
# the synthetic conversations, the rule sheets and the bases. Any server with /v1/chat/completions and /health works.
REIN_TEACHER_URL=https://your-teacher-endpoint.example
REIN_TEACHER_MODEL=
# When the teacher is a Modal app: its name, so a job stops its containers when it ends (leave empty otherwise).
REIN_TEACHER_APP=

# Proxy authentication, for endpoints behind Modal's proxy auth (set both or neither).
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# The auditor: an OpenAI-compatible endpoint serving Qwen3.8-27B, which re-checks labels and judges replies.
# modal_apps/auditor_app.py deploys one on Modal.
REIN_AUDITOR_URL=https://your-auditor-endpoint.example
